<% layout("layouts/boilerplate.ejs") %>

<div class="login-container">
  <div class="login-form">

    <div class="login-header">
      <h1>Welcome Back 👋</h1>
      <p>Login to continue to your account</p>
    </div>

    <form action="/auth/login" method="POST">

      <div class="login-credentials">
        <label for="email">Email</label>
        <input
          type="email"
          name="email"
          id="email"
          placeholder="Enter your email"
          required
        />
      </div>

      <div class="login-credentials">
        <label for="password">Password</label>
        <input
          type="password"
          name="password"
          id="password"
          placeholder="Enter your password"
          required
        />
      </div>

      <div class="login-options">

        <a href="/forgot-password">Forgot password?</a>
      </div>

      <button type="submit" class="login-btn">
        Login
      </button>

    </form>

    <div class="signup-text">
      Don't have an account?
      <a href="/auth/signup">Create an account</a>
    </div>

  </div>
</div>

<style>
  .login-container {
    min-height: 85vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 30px 20px;
    background: linear-gradient(135deg, #eef2ff, #f8fafc);
  }

  .login-form {
    width: 100%;
    max-width: 400px;
    padding: 35px;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid #e5e7eb;
    border-radius: 18px;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.08);
  }

  .login-header {
    text-align: center;
    margin-bottom: 25px;
  }

  .login-header h1 {
    margin: 0;
    font-size: 28px;
    font-weight: 700;
    color: #111827;
  }

  .login-header p {
    margin-top: 8px;
    color: #6b7280;
    font-size: 14px;
  }

  .login-credentials {
    display: flex;
    flex-direction: column;
    margin-bottom: 18px;
  }

  .login-credentials label {
    margin-bottom: 7px;
    font-size: 14px;
    font-weight: 600;
    color: #374151;
  }

  .login-credentials input {
    width: 100%;
    box-sizing: border-box;
    padding: 12px 14px;
    border: 1px solid #d1d5db;
    border-radius: 9px;
    outline: none;
    font-size: 14px;
    transition: 0.2s ease;
    background: #f9fafb;
  }

  .login-credentials input:focus {
    border-color: #6366f1;
    background: white;
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.12);
  }

  .login-credentials input::placeholder {
    color: #9ca3af;
  }

  .login-options {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 5px 0 22px;
    font-size: 13px;
  }

  .remember {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #6b7280;
  }

  .remember input {
    accent-color: #6366f1;
  }

  .login-options a,
  .signup-text a {
    color: #4f46e5;
    text-decoration: none;
    font-weight: 600;
  }

  .login-options a:hover,
  .signup-text a:hover {
    text-decoration: underline;
  }

  .login-btn {
    width: 100%;
    border: none;
    padding: 13px;
    border-radius: 9px;
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    color: white;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: 0.25s ease;
  }

  .login-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(79, 70, 229, 0.25);
  }

  .login-btn:active {
    transform: translateY(0);
  }

  .signup-text {
    text-align: center;
    margin-top: 22px;
    font-size: 13px;
    color: #6b7280;
  }

  @media (max-width: 480px) {
    .login-container {
      padding: 20px 15px;
    }

    .login-form {
      padding: 25px 20px;
    }

    .login-header h1 {
      font-size: 24px;
    }
  }
</style>