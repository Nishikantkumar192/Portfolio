<section id="projects">
  <div style="display: flex; flex-direction: column; justify-content: center; align-items: center;">
    <h2 style="color: red;">Projects</h2>
    <div style="display: flex; flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: stretch; gap: 24px; max-width: 1080px; margin: 0 auto;">
      <%projects.forEach((project)=>{%>
      <div class="project-card">

        <img src="<%= project.images[0].url %>" alt="<%= project.title %>">

        <div class="project-content">

          <h3><%= project.title %></h3>

          <div class="project-links">
            <a href="<%= project.projectLink %>" target="_blank">
              Live Demo
            </a>

            <a href="<%= project.githubLink %>" target="_blank">
              GitHub
            </a>
            <a href="/portfolio/particular-project/<%=project._id%>">
              show-project
            </a>
          </div>

        </div>

      </div>
      <%})%>
    </div>
  </div>
</section>

