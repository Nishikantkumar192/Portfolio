<% layout("layouts/boilerplate.ejs") %>

<div class="resume-container">

  <div class="resume-card">

    <div class="resume-icon">
      📄
    </div>

    <h1>Update Resume</h1>

    <p>
      Upload your latest resume in PDF format.
    </p>

    <form action="/portfolio/add-new-resume" method="POST" enctype="multipart/form-data">

      <label for="resume" class="file-upload">
        <span class="upload-icon">⬆</span>
        <span class="upload-text">Choose Resume</span>
        <span class="file-name">PDF files only</span>

        <input
          type="file"
          name="resume"
          id="resume"
          accept=".pdf,application/pdf"
          required
        />
      </label>

      <button type="submit">
        Upload Resume
      </button>

    </form>

  </div>

</div>

<style>

  .resume-container {
    min-height: 85vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 30px 20px;
    background: linear-gradient(135deg, #eef2ff, #f8fafc);
  }

  .resume-card {
    width: 100%;
    max-width: 420px;
    padding: 35px;
    text-align: center;
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 18px;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.08);
  }

  .resume-icon {
    width: 65px;
    height: 65px;
    margin: 0 auto 15px;

    display: flex;
    justify-content: center;
    align-items: center;

    border-radius: 50%;
    background: #eef2ff;
    font-size: 30px;
  }

  .resume-card h1 {
    margin: 0;
    color: #111827;
    font-size: 26px;
  }

  .resume-card p {
    margin: 10px 0 25px;
    color: #6b7280;
    font-size: 14px;
  }

  .file-upload {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    min-height: 150px;
    padding: 20px;

    border: 2px dashed #c7d2fe;
    border-radius: 12px;
    background: #f8faff;

    cursor: pointer;
    transition: 0.2s ease;
  }

  .file-upload:hover {
    border-color: #6366f1;
    background: #eef2ff;
  }

  .file-upload input {
    display: none;
  }

  .upload-icon {
    font-size: 30px;
    color: #6366f1;
    margin-bottom: 8px;
  }

  .upload-text {
    font-size: 15px;
    font-weight: 600;
    color: #374151;
  }

  .file-name {
    margin-top: 5px;
    font-size: 12px;
    color: #9ca3af;
  }

  .resume-card button {
    width: 100%;
    margin-top: 20px;
    padding: 13px;

    border: none;
    border-radius: 9px;

    background: linear-gradient(135deg, #6366f1, #4f46e5);
    color: white;

    font-size: 15px;
    font-weight: 600;

    cursor: pointer;
    transition: 0.2s ease;
  }

  .resume-card button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(79, 70, 229, 0.25);
  }

</style>